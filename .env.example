# ==============================================================================
# GLOBUS ELEVATORS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Set these environment variables in your Vercel Project Settings (or in .env.local for local testing)

# Brevo (formerly Sendinblue) API Key (starts with xkeysib-...)
# Obtain from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_v3_api_key_here

# Verified Sender Email in Brevo
# Must be added & verified in: https://app.brevo.com/senders
BREVO_SENDER_EMAIL=info@globuselevators.com

# Sender Display Name
BREVO_SENDER_NAME=Globus Elevators Web

# Admin / Sales Inbox where new customer inquiries should be delivered
CONTACT_RECEIVER_EMAIL=info@globuselevators.com
